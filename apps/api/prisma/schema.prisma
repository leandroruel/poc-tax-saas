generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantSegment {
  credit_provider
  insurance_pension
}

enum PlatformRole {
  user
  super_admin
}

enum RuleEditorialStatus {
  draft
  pending_review
  approved
  rejected
  revoked
}

enum ImportBatchStatus {
  draft
  validating
  ready
  processing
  requires_review
  closed
  failed
  cancelled
}

enum BackgroundJobStatus {
  queued
  active
  retrying
  completed
  failed
  cancelled
}

enum JobAttemptStatus {
  active
  completed
  failed
}

enum ImportBatchRowStatus {
  valid
  invalid
  processed
  failed
}

enum NotificationType {
  batch_completed
  batch_requires_review
  job_failed
  job_recovered
  export_ready
  rule_scheduled
  rule_activated
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  platformRole  PlatformRole @default(user)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions        Session[]
  accounts        Account[]
  membership      Member?
  invitationsSent Invitation[]           @relation("InvitationInviter")
  profile         UserProfile?
  calculations    Calculation[]
  rulesCreated    TaxRuleVersion[]       @relation("RuleCreatedBy")
  rulesReviewed   TaxRuleVersion[]       @relation("RuleReviewedBy")
  auditEvents     AuditLog[]             @relation("AuditActor")
  importBatches   ImportBatch[]
  importMappings  ImportMappingProfile[]
  backgroundJobs  BackgroundJob[]
  notifications   Notification[]
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?  @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id        String        @id @db.Uuid
  name      String
  slug      String        @unique
  logo      String?
  metadata  String?
  taxId     String        @unique
  segment   TenantSegment
  createdAt DateTime      @default(now())

  members        Member[]
  invitations    Invitation[]
  calculations   Calculation[]
  auditEvents    AuditLog[]
  importBatches  ImportBatch[]
  importMappings ImportMappingProfile[]
  backgroundJobs BackgroundJob[]
  notifications  Notification[]
}

model Member {
  id             String       @id
  organizationId String       @db.Uuid
  userId         String       @unique
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Invitation {
  id             String       @id
  organizationId String       @db.Uuid
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model UserProfile {
  userId          String   @id
  taxIdCiphertext String
  taxIdIv         String
  taxIdAuthTag    String
  taxIdBlindIndex String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaxRule {
  id            String           @id
  code          String           @unique
  taxType       String           @default("IOF")
  operationType String
  versions      TaxRuleVersion[]
  createdAt     DateTime         @default(now())

  @@index([taxType, operationType])
}

model TaxRuleVersion {
  id              String              @id
  ruleId          String
  version         Int
  editorialStatus RuleEditorialStatus @default(draft)
  effectiveFrom   DateTime            @db.Date
  effectiveTo     DateTime?           @db.Date
  treatment       Json
  legalBasis      String
  sourceUrl       String
  changeReason    String
  snapshotHash    String
  createdById     String
  reviewedById    String?
  approvedAt      DateTime?
  createdAt       DateTime            @default(now())
  rule            TaxRule             @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  createdBy       User                @relation("RuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy      User?               @relation("RuleReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  calculations    Calculation[]

  @@unique([ruleId, version])
  @@index([editorialStatus, effectiveFrom, effectiveTo])
}

model Calculation {
  id             String          @id
  organizationId String          @db.Uuid
  createdById    String
  operationType  String
  occurredOn     DateTime        @db.Date
  input          Json
  outcome        Json
  ruleVersionId  String?
  ruleSnapshot   Json?
  recalculatesId String?
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  ruleVersion    TaxRuleVersion? @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  recalculates   Calculation?    @relation("CalculationRevision", fields: [recalculatesId], references: [id], onDelete: Restrict)
  recalculations Calculation[]   @relation("CalculationRevision")
  importRow      ImportBatchRow?

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdById])
  @@index([ruleVersionId])
  @@index([recalculatesId])
}

model AuditLog {
  id             String        @id
  actorUserId    String?
  organizationId String?       @db.Uuid
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  metadata       Json?
  occurredAt     DateTime      @default(now())
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model ImportBatch {
  id               String                @id
  organizationId   String                @db.Uuid
  createdById      String
  status           ImportBatchStatus     @default(draft)
  sourceKind       String                @default("manual_upload")
  originalFileName String?
  objectKey        String?
  contentHash      String?
  operationType    String?
  delimiter        String?
  detectedHeaders  Json?
  mapping          Json?
  mappingProfileId String?
  totalRows        Int                   @default(0)
  validRows        Int                   @default(0)
  invalidRows      Int                   @default(0)
  processedRows    Int                   @default(0)
  failedRows       Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  closedAt         DateTime?
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy        User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  mappingProfile   ImportMappingProfile? @relation(fields: [mappingProfileId], references: [id], onDelete: SetNull)
  jobs             BackgroundJob[]
  rows             ImportBatchRow[]

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdById])
  @@index([mappingProfileId])
  @@index([status, updatedAt])
}

model ImportMappingProfile {
  id             String        @id
  organizationId String        @db.Uuid
  createdById    String
  name           String
  operationType  String
  mapping        Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  batches        ImportBatch[]

  @@unique([organizationId, name])
  @@index([createdById])
  @@index([organizationId, operationType, updatedAt(sort: Desc)])
}

model ImportBatchRow {
  id               String               @id
  batchId          String
  rowNumber        Int
  status           ImportBatchRowStatus
  rawData          Json
  normalizedInput  Json?
  validationErrors Json?
  calculationId    String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  batch            ImportBatch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  calculation      Calculation?         @relation(fields: [calculationId], references: [id], onDelete: Restrict)

  @@unique([batchId, rowNumber])
  @@index([batchId, status, rowNumber])
}

model BackgroundJob {
  id               String              @id
  organizationId   String              @db.Uuid
  createdById      String
  batchId          String?
  type             String
  status           BackgroundJobStatus @default(queued)
  payload          Json
  progressCurrent  Int                 @default(0)
  progressTotal    Int                 @default(0)
  attemptsMade     Int                 @default(0)
  maxAttempts      Int                 @default(3)
  dispatchVersion  Int                 @default(0)
  correlationId    String              @unique
  lastErrorCode    String?
  lastErrorMessage String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  startedAt        DateTime?
  finishedAt       DateTime?
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy        User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  batch            ImportBatch?        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  attempts         JobAttempt[]

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdById])
  @@index([batchId])
  @@index([status, updatedAt])
}

model JobAttempt {
  id            String           @id
  jobId         String
  number        Int
  status        JobAttemptStatus
  correlationId String
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?
  job           BackgroundJob    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, number])
  @@index([jobId, startedAt])
}

model Notification {
  id             String           @id
  organizationId String           @db.Uuid
  userId         String
  type           NotificationType
  title          String
  message        String
  entityType     String
  entityId       String
  createdAt      DateTime         @default(now())
  readAt         DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}
