PERSONAL_DATA_INDEX_KEY=another-base64-encoded-32-byte-key
TAXMAN_ADMIN_EMAIL=admin@taxman.local
TAXMAN_ADMIN_PASSWORD=replace-this-local-password
TAXMAN_ALLOW_INSECURE_DEV_SECRETS=false
